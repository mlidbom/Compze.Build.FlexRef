<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- MSBuildLocator only accepts an SDK whose runtime is not newer than the running process.
         RollForward=Major lets the tool start on a newer-major runtime when no .NET 10 runtime is
         present, so it keeps working on machines that only have a future SDK installed. -->
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <NoWarn>$(NoWarn);NU1701</NoWarn>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>flexref</ToolCommandName>

    <PackageId>Compze.Build.FlexRef</PackageId>
    <Description>ProjectReference and PackageReference merged into one. Automatically switches based on the open solution.</Description>
    <Authors>MagnusLidbom</Authors>
    <Copyright>Copyright (c) Lidbom Solutions AB. All rights reserved.</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/mlidbom/Compze.Build.FlexRef</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mlidbom/Compze.Build.FlexRef</RepositoryUrl>
    <PackageTags>msbuild;nuget;project-reference;package-reference;solution;build;dotnet;cli</PackageTags>
    <PackageIcon>compze-icon.png</PackageIcon>
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build" Version="18.*" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="all" />
  </ItemGroup>
   
  <ItemGroup>
    <InternalsVisibleTo Include="Compze.Build.FlexRef.Specifications" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="FlexRef.props" LogicalName="FlexRef.props" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\compze-icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\CHANGELOG.md">
      <Link>CHANGELOG.md</Link>
    </Content>
  </ItemGroup>

</Project>
